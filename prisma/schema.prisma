generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  GUARDIAN
}

enum AccountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  ON_HOLD
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ActivityPlanPeriod {
  WEEK
  MONTH
}

enum ActivityPlanStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  email              String?             @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean             @default(true)
  approvalStatus     AccountApprovalStatus @default(APPROVED)
  staffProfile       StaffProfile?
  guardianProfile    GuardianProfile?
  authoredActivities Activity[]          @relation("ActivityAuthor")
  authoredActivityPlans ActivityPlan[]   @relation("ActivityPlanAuthor")
  authoredGoals      Goal[]              @relation("GoalAuthor")
  authoredRatings    PerformanceRating[] @relation("RatingAuthor")
  uploadedMedia      MediaAsset[]        @relation("MediaUploader")
  adminConversations Conversation[]      @relation("ConversationAdmin")
  staffConversations Conversation[]      @relation("ConversationStaff")
  peerStaffConversations Conversation[]  @relation("ConversationPeerStaff")
  sentMessages       Message[]           @relation("MessageSender")
  authoredReviews    Review[]            @relation("ReviewAuthor")
  respondedReviews   Review[]            @relation("ReviewResponder")
  notifications      Notification[]      @relation("NotificationRecipient")
  auditLogs          AuditLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model StaffProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  employeeNumber String?           @unique
  firstName      String
  lastName       String
  jobTitle       String?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    StaffAssignment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model GuardianProfile {
  id        String          @id @default(uuid())
  userId    String          @unique
  firstName String
  lastName  String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children  ChildGuardian[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Child {
  id               String              @id @default(uuid())
  firstName        String
  lastName         String
  isActive         Boolean             @default(true)
  guardians        ChildGuardian[]
  staffAssignments StaffAssignment[]
  activities       Activity[]
  activityPlans    ActivityPlan[]
  goals            Goal[]
  ratings          PerformanceRating[]
  mediaAssets      MediaAsset[]
  reviews          Review[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ChildGuardian {
  childId          String
  guardianId       String
  relationship     String
  isPrimaryContact Boolean         @default(false)
  canPickup        Boolean         @default(false)
  child            Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian         GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@id([childId, guardianId])
  @@index([guardianId])
}

model StaffAssignment {
  id             String       @id @default(uuid())
  staffProfileId String
  childId        String
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  child          Child        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, childId])
  @@index([childId])
}

model Activity {
  id          String       @id @default(uuid())
  childId     String
  createdById String
  title       String
  description String?
  activityAt  DateTime     @default(now())
  child       Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("ActivityAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  mediaAssets MediaAsset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([childId, activityAt])
}

model ActivityPlan {
  id          String              @id @default(uuid())
  childId     String
  createdById String
  period      ActivityPlanPeriod
  periodStart DateTime
  title       String
  description String?
  plannedFor  DateTime?
  status      ActivityPlanStatus  @default(PLANNED)
  child       Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("ActivityPlanAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([childId, period, periodStart])
}

model Goal {
  id          String     @id @default(uuid())
  childId     String
  createdById String
  title       String
  description String?
  status      GoalStatus @default(NOT_STARTED)
  targetDate  DateTime?
  child       Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("GoalAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([childId, status])
}

model PerformanceRating {
  id          String   @id @default(uuid())
  childId     String
  createdById String
  category    String
  score       Int
  notes       String?
  ratedAt     DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("RatingAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([childId, ratedAt])
}

model MediaAsset {
  id           String    @id @default(uuid())
  childId      String
  activityId   String?
  uploadedById String
  kind         MediaKind
  originalName String
  mimeType     String
  storageKey   String    @unique
  sizeBytes    Int
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  uploadedBy   User      @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([childId, createdAt])
}

model Conversation {
  id            String    @id @default(uuid())
  adminId       String?
  staffId       String
  peerStaffId   String?
  lastMessageAt DateTime?
  admin         User?     @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  staff         User      @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  peerStaff     User?     @relation("ConversationPeerStaff", fields: [peerStaffId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([adminId, staffId])
  @@unique([staffId, peerStaffId])
  @@index([adminId, lastMessageAt])
  @@index([staffId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id                String         @id @default(uuid())
  childId           String
  authorId          String
  rating            Int?
  comment           String
  staffResponse     String?
  staffRespondedById String?
  staffRespondedAt  DateTime?
  child             Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  author            User           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  staffRespondedBy  User?          @relation("ReviewResponder", fields: [staffRespondedById], references: [id], onDelete: SetNull)
  notifications     Notification[]
  createdAt         DateTime       @default(now())

  @@index([childId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id               String   @id @default(uuid())
  recipientUserId  String
  reviewId         String
  readAt           DateTime?
  recipient        User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  review           Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([recipientUserId, reviewId])
  @@index([recipientUserId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  method     String
  route      String
  statusCode Int
  occurredAt DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([occurredAt, id])
  @@index([actorId, occurredAt])
}
